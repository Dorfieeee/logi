{
    "name": "logi",
    "version": "1.1.0",
    "private": true,
    "overrides": {
        "react-remove-scroll-bar": "2.3.7",
        "zod": "4.3.6",
        "@discordjs/ws": "1.2.3"
    },
    "scripts": {
        "dev": "next dev",
        "dev:all": "concurrently \"next dev\" \"tsx discord-bot/src/index.ts\"",
        "bot:dev": "tsx discord-bot/src/index.ts",
        "test": "node --import tsx --import ./scripts/test-env.ts --test \"src/**/*.test.ts\" \"discord-bot/src/**/*.test.ts\"",
        "test:coverage": "node --import tsx --test --experimental-test-coverage \"src/**/*.test.ts\" \"discord-bot/src/**/*.test.ts\"",
        "test:domain": "node --import tsx --test \"src/domain/**/*.test.ts\"",
        "bot:test": "node --import tsx --test \"discord-bot/src/**/*.test.ts\"",
        "build": "next build",
        "build-show-all-errors": "cross-env NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=4096 __NEXT_TEST_MODE=true next build",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "check:convex-bundles": "node scripts/check-convex-bundles.mjs",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "generate:openapi": "tsx scripts/generate-openapi-schemas.ts",
        "convex:deploy": "convex deploy",
        "postinstall": "patch-package --error-on-fail"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
