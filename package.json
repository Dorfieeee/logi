        "@types/node": "^25.9.9",
        "@types/react": "^19.3.0",
        "@types/react-big-calendar": "^1.16.3",
        "@types/react-dom": "^19.3.0",
        "concurrently": "^10.0.6",
        "eslint": "^9.39.5",
