        "@radix-ui/react-toggle-group": "^1.2.1",
        "@radix-ui/react-tooltip": "^1.4.1",
        "@scalar/nextjs-api-reference": "^0.11.18",
        "@tailwindcss/postcss": "^4.3.3",
        "@tanstack/react-table": "^8.21.3",
        "@uiw/react-md-editor": "^4.1.3",
        "cheerio": "1.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "convex": "^1.48.0",
        "date-fns": "^4.4.0",
        "discord.js": "^14.27.0",
        "dotenv": "^17.4.2",
        "emoji-picker-react": "^4.22.3",
        "framer-motion": "^13.5.1",
        "jose": "^6.2.13",
        "jszip": "^3.10.2",
        "lucide-react": "^0.562.0",
        "motion": "^13.5.1",
        "next": "^16.4.3",
        "next-intl": "^4.14.9",
        "next-themes": "^0.4.6",
        "nextjs-toploader": "^3.9.17",
        "nextra": "^4.6.1",
        "nextra-theme-docs": "^4.6.1",
        "nextstepjs": "^2.3.0",
        "passport-steam-openid": "1.1.12",
        "patch-package": "8.0.1",
        "postcss": "^8.5.31",
